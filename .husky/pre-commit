#!/bin/sh
set -eu

# Validate before changing tracked version files. A failed check aborts the commit.
npm run verify

# Bump frontend patch version on every commit
node -e "
const fs = require('fs');
const pkg = JSON.parse(fs.readFileSync('frontend/package.json', 'utf8'));
const parts = pkg.version.split('.').map(Number);
parts[2] += 1;
pkg.version = parts.join('.');
fs.writeFileSync('frontend/package.json', JSON.stringify(pkg, null, 2) + '\n');
console.log('Version bumped to ' + pkg.version);
"
node scripts/sync-workspace-version.mjs
git add frontend/package.json package-lock.json
